{
  "info": {
    "name": "Realtime Chat & Notification System",
    "description": "REST API collection for the Realtime Chat & Notification System backend (NestJS). Covers Auth, Users, Rooms, and Notifications endpoints. WebSocket/Socket.IO events are documented separately in the README.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "otherUserId", "value": "", "type": "string" },
    { "key": "roomId", "value": "", "type": "string" },
    { "key": "notificationId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Signup",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"test@test.com\",\n  \"password\": \"test123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/signup",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "signup"]
            },
            "description": "Create a new account. Returns { accessToken, user }."
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@test.com\",\n  \"password\": \"test123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Log in with existing credentials. Returns { accessToken, user }. Copy the accessToken into the 'accessToken' collection variable to authenticate the requests below."
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Search Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/search?q=second",
              "host": ["{{baseUrl}}"],
              "path": ["users", "search"],
              "query": [{ "key": "q", "value": "second" }]
            },
            "description": "Search users by name or email (excludes the requesting user). Requires auth."
          }
        }
      ]
    },
    {
      "name": "Rooms",
      "item": [
        {
          "name": "Create/Get Direct Room",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otherUserId\": \"{{otherUserId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/direct",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "direct"]
            },
            "description": "Creates a new 1-on-1 chat room with the given user, or returns the existing one if it already exists."
          }
        },
        {
          "name": "Create Group Room",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Project Team\",\n  \"memberIds\": [\"{{otherUserId}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/rooms/group",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "group"]
            },
            "description": "Creates a group chat room with the given member IDs (creator is added automatically)."
          }
        },
        {
          "name": "List My Rooms",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            },
            "description": "Lists all rooms the authenticated user belongs to, including members and the latest message preview."
          }
        },
        {
          "name": "Get Room Messages",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/rooms/{{roomId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "{{roomId}}", "messages"]
            },
            "description": "Fetches full message history for a room. Requires the requesting user to be a member of the room."
          }
        }
      ]
    },
    {
      "name": "Notifications",
      "item": [
        {
          "name": "Get All Notifications",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications",
              "host": ["{{baseUrl}}"],
              "path": ["notifications"]
            },
            "description": "Lists all notifications for the authenticated user, newest first."
          }
        },
        {
          "name": "Get Unread Count",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/unread-count",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "unread-count"]
            },
            "description": "Returns the count of unread notifications for the authenticated user."
          }
        },
        {
          "name": "Mark Notification as Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/{{notificationId}}/read",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "{{notificationId}}", "read"]
            },
            "description": "Marks a single notification as read."
          }
        },
        {
          "name": "Mark All as Read",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/notifications/read-all",
              "host": ["{{baseUrl}}"],
              "path": ["notifications", "read-all"]
            },
            "description": "Marks all of the authenticated user's notifications as read."
          }
        }
      ]
    }
  ]
}
